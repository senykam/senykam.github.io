{% comment %}
  Renders one list of writing. Every section of /writing/ and /power/ goes
  through this include so the entries all look the same.

  Horizontal rules separate sections and nothing else, so entries are bullets
  with no dividers between them.

  Usage: {% include writing_list.liquid items=some_array %}
         {% include writing_list.liquid items=notes ordered=true descriptions=true %}

  Entries are a title and a byline. Pass descriptions=true to also show each
  item's description, which the notes use and the other sections do not.

  Each item may be a post or an entry from _data/writing.yml, and can carry:
    title        required
    short_title  used instead of title when ordered=true
    url          where it lives; posts get this from Jekyll
    redirect     external URL, which wins over url and adds the off-site arrow
    description  one or two lines
    date         formatted and shown first when present
    venue        where it appeared, e.g. "Substack", shown after the date
    meta         same job as venue, for data entries; venue wins if both are set
    links        list of {name, url} for the same piece elsewhere, shown inline
                 on the byline
{% endcomment %}

{% if include.items and include.items != empty %}
{% if include.ordered %}<ol class="entry-list numbered">{% else %}<ul class="entry-list">{% endif %}
{% for item in include.items %}
{% if item.redirect %}{% assign href = item.redirect %}{% else %}{% assign href = item.url %}{% endif %}
{% if include.ordered and item.short_title %}{% assign label = item.short_title %}{% else %}{% assign label = item.title %}{% endif %}
<li>
{% if href contains '://' %}
<a class="entry-title" href="{{ href }}" target="_blank">{{ label }}</a><svg width="1.6rem" height="1.6rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"><path d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9" class="icon_svg-stroke" stroke="#999" stroke-width="1.5" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"></path></svg>
{% else %}
<a class="entry-title" href="{{ href | relative_url }}">{{ label }}</a>
{% endif %}
{% if include.descriptions and item.description %}<p class="entry-desc">{{ item.description }}</p>{% endif %}
{% if item.venue %}{% assign where = item.venue %}{% else %}{% assign where = item.meta %}{% endif %}
{% if item.posts_kind %}{% assign unit = item.unit | default: 'note' %}{% assign sp = site.posts | where_exp: "post", "post.hidden != true" | where: "kind", item.posts_kind | sort: "date" | reverse %}{% capture where %}{{ sp.size }} {{ unit }}{% if sp.size != 1 %}s{% endif %}{% if sp.size > 0 %} &nbsp;&middot;&nbsp; most recent {{ sp.first.date | date: '%B %Y' }}{% endif %}{% endcapture %}{% endif %}
<p class="entry-meta">{% if item.date %}{{ item.date | date: '%B %-d, %Y' }}{% if where %} &nbsp;&middot;&nbsp; {% endif %}{% endif %}{{ where }}{% if item.links %} &nbsp;&middot;&nbsp; {% for link in item.links %}<a href="{{ link.url }}" target="_blank">{{ link.name }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}{% endif %}</p>
</li>
{% endfor %}
{% if include.ordered %}</ol>{% else %}</ul>{% endif %}
{% endif %}
