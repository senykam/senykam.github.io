{% if site.enable_math %}
  <!-- MathJax -->
  <script type="text/javascript">
    // Write all math with $$...$$, inline or display. kramdown parses those as
    // math spans and hands MathJax \(..\) or \[..\], its defaults.
    //
    // Single $...$ is deliberately not enabled. kramdown does not recognise it
    // as math, so it markdown-processes the contents first: subscript pairs
    // become <em> and \{ loses its escape. MathJax would then render corrupted
    // LaTeX rather than failing visibly.
    window.MathJax = {
      tex: {
        tags: 'ams',
        processEscapes: true,
      },
    };
  </script>
  <script
    defer
    type="text/javascript"
    id="MathJax-script"
    src="https://cdn.jsdelivr.net/npm/mathjax@{{ site.mathjax.version }}/es5/tex-mml-chtml.js"
  ></script>
  <script defer src="https://polyfill.io/v3/polyfill.min.js?features=es6"></script>
{% endif %}
